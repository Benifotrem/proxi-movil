# Copiar a .env y completar:  cp .env.example .env && chmod 600 .env

# Subdominio público servido por Cloudflare Tunnel.
PUBLIC_HOSTNAME=proxy.tudominio.com

# Nombre del túnel de Cloudflare (y del servicio systemd cloudflared-<nombre>).
TUNNEL_NAME=proxi-movil

# API key exigida en la cabecera X-API-KEY. Generar con:  openssl rand -hex 32
# Usar solo caracteres [A-Za-z0-9] (sin comillas ni espacios).
API_KEY=

# API Flask de control en el servidor HP, accesible desde el VPS por Tailscale/WireGuard.
FARM_API_HOST=100.64.0.10
FARM_API_PORT=5000

# Orígenes permitidos por CORS (regex sobre la cabecera Origin).
# Ej. cualquier origen: CORS_ORIGIN_REGEX=.*
CORS_ORIGIN_REGEX='^https://(www\.)?soymas\.pro$'
