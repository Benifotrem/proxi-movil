# Trabajador de captura de muestras (proxi-captura.service). Permisos: 0600 root.
# URL de la API de trabajadores del backend y el mismo token que CAPTURE_WORKER_TOKEN del .env del hosting.
CAPTURA_API_URL=https://nodecellular.com/worker
CAPTURA_TOKEN=
# Móviles por los que salen las visitas (rotación). Solo móviles sin cliente asignado.
CAPTURA_MODEMS=modem_2_3,modem_2_4
# Segundos mínimos entre dos visitas al mismo dominio.
CAPTURA_DOMAIN_DELAY=8
